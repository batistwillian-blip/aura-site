---
import Base from '../layouts/Base.astro';
import WaIcon from '../components/WaIcon.astro';
import { whatsappLink } from '../data/site';
---
<Base title="Página não encontrada" description="A página que você procura não existe.">
  <section class="page-hero">
    <div class="container">
      <span class="kick">Erro 404</span>
      <h1>Essa página não existe</h1>
      <p class="sub">Talvez o endereço tenha mudado. Volte para o início ou fale com a Aurora, que ela ajuda você a encontrar o curso.</p>
      <div class="ctas">
        <a class="btn-pri" href="/">Voltar ao início</a>
        <a class="btn-wa" href={whatsappLink()} target="_blank" rel="noopener" data-wa="404"><WaIcon />Falar com a Aurora</a>
      </div>
    </div>
  </section>
</Base>
