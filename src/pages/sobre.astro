---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import WaIcon from '../components/WaIcon.astro';
import { site, whatsappLink } from '../data/site';
import { parceiras, avisoMestrado } from '../data/cursos';

const check = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
---
<Base title="Sobre a AURA" description={`A AURA Hub Educacional existe desde ${site.fundacao} em Balneário Camboriú e reúne EJA, técnicos, graduação, pós e mestrado em um só lugar, com instituições parceiras reconhecidas.`}>
  <section class="page-hero tech about-hero">
    <span class="luz" aria-hidden="true"></span>
    <div class="container">
      <nav class="crumbs" aria-label="Você está em"><a href="/">Início</a><span>›</span><span>Sobre a AURA</span></nav>
      <Logo dark width={300} class="about-logo" />
      <span class="kick">Desde {site.fundacao} em Balneário Camboriú</span>
      <h1>Educação para cada fase da sua vida. <em>Em um só lugar.</em></h1>
      <p class="sub">A AURA nasceu em {site.fundacao}, em Balneário Camboriú, para simplificar a vida de quem quer estudar. Em vez de procurar uma escola para cada fase, você encontra aqui o EJA, os cursos técnicos, a graduação, a pós e o mestrado, com orientação de verdade do começo ao diploma.</p>
    </div>
  </section>

  <section class="blk">
    <div class="container two">
      <div class="prose">
        <section>
          <h2>Quem somos</h2>
          <p>A AURA Hub Educacional é a frente de educação da {site.razaoSocial}. Somos polo oficial da UNIFAEL em Balneário Camboriú e representamos instituições parceiras que oferecem o conteúdo e emitem o diploma. A gente escolhe essas parceiras, orienta você na escolha do curso, cuida da matrícula e acompanha sua jornada.</p>
        </section>
        <section>
          <h2>No que acreditamos</h2>
          <ul class="checks">
            <li><Fragment set:html={check} /><span><b>Clareza.</b> Valores, prazos e documentos sem letras miúdas.</span></li>
            <li><Fragment set:html={check} /><span><b>Acolhimento.</b> Ninguém é julgado por ter parado de estudar. Recomeçar é normal.</span></li>
            <li><Fragment set:html={check} /><span><b>Honestidade.</b> Indicamos o caminho certo para você, mesmo que não seja o mais caro.</span></li>
            <li><Fragment set:html={check} /><span><b>Agilidade.</b> A Aurora responde na hora, e uma pessoa da equipe assume sempre que você quiser.</span></li>
          </ul>
        </section>
        <section>
          <h2>Por que "AURA"</h2>
          <p>Aura é a luz que envolve. É o que queremos ser para cada aluno: uma presença que ilumina o próximo passo, do supletivo ao mestrado. O ponto de luz no nosso símbolo representa isso.</p>
        </section>
      </div>
      <aside class="side">
        <span class="pill-ai on-light">Aurora online</span>
        <h3>Fale com a gente</h3>
        <p>A Aurora responde 24h pelo WhatsApp. Se preferir, venha ao polo: {site.endereco.linha1}, {site.endereco.linha2}.</p>
        <a class="btn-wa" href={whatsappLink()} target="_blank" rel="noopener" data-wa="sobre"><WaIcon />Falar com a Aurora</a>
        <div class="by">{site.nome} · desde {site.fundacao}</div>
      </aside>
    </div>
  </section>

  <section class="blk alt" id="parceiras">
    <div class="container">
      <div class="blk-h"><span class="kick">Instituições parceiras</span><h2>Quem emite o seu diploma</h2></div>
      <div class="partners">
        {Object.values(parceiras).map((p) => (
          <div class="pa"><span class="what">{p.papel}</span><div class="nm">{p.nome}</div><p>{p.descricao}</p></div>
        ))}
      </div>
      <p class="disclaimer">A AURA Hub Educacional é polo e representante comercial. Os diplomas e certificados são emitidos pelas instituições parceiras. {avisoMestrado}</p>
    </div>
  </section>
</Base>
