---
import Base from '../layouts/Base.astro';
import CourseCard from '../components/CourseCard.astro';
import WaIcon from '../components/WaIcon.astro';
import { whatsappLink } from '../data/site';
import { niveis, cursosDoNivel, parceiras, avisoMestrado, type Nivel } from '../data/cursos';
import { areas, type Area } from '../data/areas';
import { vigenciaPosTexto } from '../data/pos';

export function getStaticPaths() {
  return niveis.map((n) => ({ params: { nivel: n.id }, props: { nivel: n } }));
}

const { nivel } = Astro.props as { nivel: Nivel };
const lista = cursosDoNivel(nivel.id);
const eja = lista.filter((c) => c.categoria === 'EJA');
const tecnicos = lista.filter((c) => c.categoria === 'Técnico');
const parceira = parceiras[nivel.parceira];
const grupos = [
  { id: 'tecnologos', kick: 'Tecnólogos · 2 a 3 anos', titulo: 'Diploma superior em menos tempo', desc: 'Graduações focadas no mercado de trabalho, com formação mais rápida.', lista: lista.filter((c) => c.grau === 'Tecnólogo') },
  { id: 'bacharelados', kick: 'Bacharelados · 3 a 5 anos', titulo: 'Formação completa para a sua profissão', desc: 'Graduações amplas, que abrem portas para cargos de gestão, concursos e especializações.', lista: lista.filter((c) => c.grau === 'Bacharelado') },
  { id: 'licenciaturas', kick: 'Licenciaturas · 4 anos', titulo: 'Para quem quer ser professor', desc: 'Formação para dar aula na educação básica, com teoria online e atividades presenciais.', lista: lista.filter((c) => c.grau === 'Licenciatura') },
].filter((g) => g.lista.length);
const contagem = new Map<Area, number>();
if (nivel.id === 'pos-graduacao') for (const c of lista) contagem.set(c.area, (contagem.get(c.area) ?? 0) + 1);
const areasPos = [...contagem.entries()].sort((a, b) => b[1] - a[1]);
const msg = `Olá! Vim pelo site da AURA e quero saber mais sobre ${nivel.titulo}.`;
const check = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: nivel.faq.map((f) => ({ '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
};
---
<Base title={nivel.titulo} description={nivel.descricao} waMessage={msg} jsonLd={faqLd}>
  <section class="page-hero tech">
    <span class="luz" aria-hidden="true"></span>
    <div class="container">
      <nav class="crumbs" aria-label="Você está em"><a href="/">Início</a><span>›</span><span>{nivel.titulo}</span></nav>
      <span class="kick">{nivel.momento}</span>
      <h1>{nivel.chamada}</h1>
      <p class="sub">{nivel.descricao}</p>
      <div class="ctas">
        <a class="btn-wa" href={whatsappLink(msg)} target="_blank" rel="noopener" data-wa={`nivel-${nivel.id}`}><WaIcon />Falar com a Aurora</a>
        {lista.length > 0 && <a class="btn-ghost" href="#cursos">Ver cursos</a>}
      </div>
    </div>
  </section>

  <section class="blk">
    <div class="container two">
      <div class="prose">
        <section>
          <h2>Por que estudar com a AURA</h2>
          <ul class="checks">
            {nivel.pontos.map((p) => <li><Fragment set:html={check} /><span>{p}</span></li>)}
          </ul>
        </section>
        {nivel.id === 'mestrado' && <p class="disclaimer">{avisoMestrado}</p>}
      </div>
      <aside class="side">
        <h3>Atendimento pelo WhatsApp</h3>
        <p>A Aurora tira suas dúvidas na hora, e a equipe do polo cuida da sua matrícula.</p>
        <a class="btn-wa" href={whatsappLink(msg)} target="_blank" rel="noopener" data-wa={`side-${nivel.id}`}><WaIcon />Quero saber mais</a>
        <div class="by">{nivel.id === 'pos-graduacao' ? 'Certificado emitido pela UNIFAEL' : parceira.selo}. A AURA é polo e representante comercial.</div>
      </aside>
    </div>
  </section>

  {lista.length > 0 && (
    <section class="blk alt" id="cursos">
      <div class="container">
        {nivel.id === 'eja-e-tecnicos' ? (
          <>
            <div class="blk-h" id="eja"><span class="kick">EJA · Supletivo</span><h2>Termine seus estudos</h2></div>
            <div class="courses c3">{eja.map((c, i) => <CourseCard curso={c} idx={i} />)}</div>
            <div class="blk-h" id="tecnicos" style="margin-top:56px"><span class="kick">Cursos técnicos</span><h2>Uma profissão em poucos meses</h2></div>
            <div class="courses c3">{tecnicos.map((c, i) => <CourseCard curso={c} idx={i + 1} />)}</div>
            <p class="disclaimer">Também temos centenas de cursos profissionalizantes livres. Pergunte à Aurora pelo WhatsApp.</p>
          </>
        ) : nivel.id === 'graduacao' ? (
          <>
            {grupos.map((gr, gi) => (
              <>
                <div class="blk-h" id={gr.id} style={gi ? 'margin-top:56px' : undefined}><span class="kick">{gr.kick}</span><h2>{gr.titulo}</h2><p>{gr.desc}</p></div>
                <div class="courses">{gr.lista.map((c, i) => <CourseCard curso={c} idx={i} />)}</div>
              </>
            ))}
          </>
        ) : nivel.id === 'pos-graduacao' ? (
          <>
            <div class="blk-h"><span class="kick">{lista.length} cursos · 100% online</span><h2>Encontre a sua especialização ou MBA</h2><p>Valores de {vigenciaPosTexto}, no boleto com pagamento até o dia 8. Busque pelo nome ou filtre por área e duração.</p></div>
            <label class="cat-search">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <span class="sr-only">Buscar pós-graduação</span>
              <input type="search" id="pos-q" placeholder="Ex.: psicopedagogia, gestão de pessoas, direito" autocomplete="off" />
            </label>
            <div class="filters small" role="group" aria-label="Filtrar por área">
              <span class="lbl">Área</span>
              <button type="button" data-area="" aria-pressed="true">Todas</button>
              {areasPos.map(([id, n]) => <button type="button" data-area={id} aria-pressed="false">{areas[id].nome} <small>({n})</small></button>)}
            </div>
            <div class="filters small" role="group" aria-label="Filtrar por duração">
              <span class="lbl">Duração</span>
              <button type="button" data-meses="" aria-pressed="true">Todas</button>
              {[4, 6, 12].map((m) => <button type="button" data-meses={m} aria-pressed="false">{m} meses</button>)}
            </div>
            <p class="count" id="pos-count" aria-live="polite">{lista.length} cursos</p>
            <div class="courses" id="pos-list">{lista.map((c, i) => <CourseCard curso={c} idx={i} />)}</div>
            <p class="empty" id="pos-empty" hidden>Nenhum curso com esse filtro. A Aurora pode procurar para você no WhatsApp.</p>
            <p class="disclaimer">Valores de {vigenciaPosTexto} para matrícula pelo polo AURA em Balneário Camboriú, sujeitos à disponibilidade de bolsas. No cartão de crédito a mensalidade é um pouco maior. Confirme a condição do dia com a Aurora.</p>
          </>
        ) : (
          <>
            <div class="blk-h"><span class="kick">Cursos disponíveis</span><h2>Escolha seu curso</h2></div>
            <div class="courses c3">{lista.map((c, i) => <CourseCard curso={c} idx={i} />)}</div>
          </>
        )}
      </div>
    </section>
  )}

  <section class="blk">
    <div class="container">
      <div class="blk-h"><span class="kick">Dúvidas frequentes</span><h2>Perguntas sobre {nivel.titulo.toLowerCase()}</h2></div>
      <div class="faq">
        {nivel.faq.map((f) => <details><summary>{f.p}</summary><p>{f.r}</p></details>)}
      </div>
    </div>
  </section>

  {nivel.id === 'pos-graduacao' && (
    <script>
      const q = document.getElementById('pos-q') as HTMLInputElement;
      const cards = Array.from(document.querySelectorAll<HTMLElement>('#pos-list .co'));
      const aBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-area]'));
      const mBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-meses]'));
      const count = document.getElementById('pos-count')!;
      const empty = document.getElementById('pos-empty')!;
      const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
      const params = new URLSearchParams(location.search);
      let area = params.get('area') ?? '';
      let meses = params.get('meses') ?? '';
      q.value = params.get('q') ?? '';
      function apply() {
        const terms = norm(q.value.trim()).split(/\s+/).filter(Boolean);
        let n = 0;
        for (const c of cards) {
          const nome = norm(c.dataset.nome || '');
          const ok = (!area || c.dataset.area === area) && (!meses || c.dataset.meses === meses) && terms.every((t) => nome.includes(t));
          c.hidden = !ok;
          if (ok) n++;
        }
        count.textContent = n === 1 ? '1 curso' : `${n} cursos`;
        empty.hidden = n > 0;
        aBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.area || '') === area)));
        mBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.meses || '') === meses)));
      }
      aBtns.forEach((b) => b.addEventListener('click', () => { area = b.dataset.area || ''; apply(); }));
      mBtns.forEach((b) => b.addEventListener('click', () => { meses = b.dataset.meses || ''; apply(); }));
      q.addEventListener('input', apply);
      apply();
    </script>
  )}
</Base>
