---
import Base from '../../layouts/Base.astro';
import CourseCard from '../../components/CourseCard.astro';
import WaIcon from '../../components/WaIcon.astro';
import { site, whatsappLink } from '../../data/site';
import { cursos, getNivel, parceiras, avisoMestrado, mensagemCurso, type Curso } from '../../data/cursos';

export function getStaticPaths() {
  return cursos.map((c) => ({ params: { slug: c.slug }, props: { curso: c } }));
}

const { curso } = Astro.props as { curso: Curso };
const nivel = getNivel(curso.nivel);
const parceira = parceiras[curso.parceira];
const msg = mensagemCurso(curso);
const pos = curso.nivel === 'pos-graduacao';
const versao = curso.versao ? cursos.find((c) => c.slug === curso.versao) : undefined;
const mesmoNivel = cursos.filter((c) => c.nivel === curso.nivel && c.slug !== curso.slug && c.slug !== curso.versao);
const relacionados = (pos ? [...mesmoNivel.filter((c) => c.area === curso.area), ...mesmoNivel.filter((c) => c.area !== curso.area)] : mesmoNivel).slice(0, 3);
const certificado = curso.parceira === 'cefe' || pos;
const vig = curso.preco ? (() => { const [m, a] = curso.preco.vigencia.split('/'); return `${['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'][Number(m) - 1]} de ${a}`; })() : '';
const check = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
const courseLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: curso.nome,
  description: curso.resumo,
  provider: { '@type': 'Organization', name: parceira.nome },
  offers: { '@type': 'Offer', category: 'Educação', seller: { '@type': 'Organization', name: site.nome } },
};
---
<Base title={curso.nome} description={`${curso.resumo} ${parceira.selo}. Matrícula com a AURA em Balneário Camboriú.`} waMessage={msg} jsonLd={courseLd}>
  <section class="page-hero tech">
    <span class="luz" aria-hidden="true"></span>
    <div class="container">
      <nav class="crumbs" aria-label="Você está em"><a href="/">Início</a><span>›</span><a href={`/${nivel.id}/`}>{nivel.titulo}</a><span>›</span><span>{curso.nome}</span></nav>
      <span class="kick">{curso.categoria}{curso.destaqueBC ? ' · Destaque em BC' : ''}</span>
      <h1>{curso.nome}</h1>
      <p class="sub">{curso.resumo}</p>
      <div class="facts">
        <span><b>Duração</b>{curso.duracao}</span>
        <span><b>Modalidade</b>{curso.modalidade}</span>
        {curso.cargaHoraria && <span><b>Carga</b>{curso.cargaHoraria}</span>}
        {curso.grau && <span><b>Grau</b>{curso.grau}</span>}
        {curso.preco && <span><b>Mensalidade</b>{curso.preco.parcelas}x de R$ {curso.preco.boleto}</span>}
        <span><b>{certificado ? 'Certificado' : 'Diploma'}</b>{parceira.nome}</span>
      </div>
      <div class="ctas">
        <a class="btn-wa" href={whatsappLink(msg)} target="_blank" rel="noopener" data-wa={`curso-${curso.slug}`}><WaIcon />Quero me matricular</a>
      </div>
    </div>
  </section>

  <section class="blk">
    <div class="container two">
      <div class="prose">
        {curso.sobre && curso.sobre.length > 0 && (
          <section>
            <h2>Sobre o curso</h2>
            {curso.sobre.map((p) => <p>{p}</p>)}
          </section>
        )}
        <section>
          <h2>Para quem é</h2>
          <p>{curso.paraQuem}</p>
        </section>
        {(curso.aprende || curso.objetivo) && (
          <section>
            <h2>{curso.aprende ? 'O que você vai aprender' : 'Objetivo do curso'}</h2>
            {curso.objetivo && <p>{curso.objetivo}</p>}
            {curso.aprende && <ul class="checks" style={curso.objetivo ? 'margin-top:14px' : undefined}>
              {curso.aprende.map((a) => <li><Fragment set:html={check} /><span>{a}</span></li>)}
            </ul>}
          </section>
        )}
        {curso.mercado && (
          <section>
            <h2>Onde você pode trabalhar</h2>
            <ul class="checks">
              {curso.mercado.map((a) => <li><Fragment set:html={check} /><span>{a}</span></li>)}
            </ul>
          </section>
        )}
        {curso.disciplinas && (
          <section>
            <h2>Disciplinas</h2>
            <ul class="disc">{curso.disciplinas.map((d) => <li>{d}</li>)}</ul>
          </section>
        )}
        {versao && (
          <section class="alt-version">
            <span>Também disponível em <b>{versao.duracao}</b>, com as mesmas disciplinas{versao.preco ? `, em ${versao.preco.parcelas}x de R$ ${versao.preco.boleto}` : ''}.</span>
            <a href={`/cursos/${versao.slug}/`}>Ver {versao.nome} →</a>
          </section>
        )}
        {pos && (
          <section>
            <h2>Como são as aulas</h2>
            <p>Tudo online: videoaulas, e-books, fóruns, biblioteca virtual e tutor para tirar dúvidas, pelo celular ou computador. O TCC não é obrigatório na maioria dos cursos. Requisito: graduação concluída (bacharelado, licenciatura ou tecnólogo).</p>
          </section>
        )}
        {curso.nivel === 'graduacao' && (
          <section>
            <h2>Formas de ingresso</h2>
            <p>Vestibular online, nota do ENEM dos últimos 5 anos, transferência de outra faculdade ou diploma de graduação. A Aurora explica qual é o melhor caminho para você.</p>
          </section>
        )}
        <section>
          <h2>Como funciona a matrícula</h2>
          <p>Fale com a Aurora pelo WhatsApp, tire suas dúvidas sobre valores, documentos e início das aulas, e finalize a matrícula online ou no nosso polo em Balneário Camboriú.</p>
        </section>
        {curso.nivel === 'mestrado' && <p class="disclaimer">{avisoMestrado}</p>}
      </div>
      <aside class="side">
        <h3>{curso.nome}</h3>
        {curso.preco ? (
          <div class="invest">
            <div class="v">{curso.preco.parcelas}x R$ {curso.preco.boleto}<small> /mês</small></div>
            <p>No boleto ou PIX, pagando até o dia 8. No cartão: {curso.preco.parcelas}x R$ {curso.preco.cartao}.</p>
            <p>Condição de {vig}, sujeita à disponibilidade de bolsas.</p>
          </div>
        ) : (
          <p>Valores, condições e próximas turmas pelo WhatsApp, na hora.</p>
        )}
        <a class="btn-wa" href={whatsappLink(msg)} target="_blank" rel="noopener" data-wa={`side-${curso.slug}`}><WaIcon />Falar com a Aurora</a>
        <div class="by">{pos ? 'Certificado emitido pela UNIFAEL' : parceira.selo}. A AURA é polo e representante comercial.</div>
      </aside>
    </div>
  </section>

  {relacionados.length > 0 && (
    <section class="blk alt">
      <div class="container">
        <div class="blk-h"><span class="kick">Veja também</span><h2>Outros cursos de {nivel.titulo.toLowerCase()}</h2></div>
        <div class="courses c3">{relacionados.map((c, i) => <CourseCard curso={c} idx={i} />)}</div>
      </div>
    </section>
  )}
</Base>
