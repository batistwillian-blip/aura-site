---
import Base from '../../layouts/Base.astro';
import CourseCard from '../../components/CourseCard.astro';
import { cursos, niveis } from '../../data/cursos';
---
<Base title="Todos os cursos" description="EJA, cursos técnicos, graduação, pós-graduação e mestrado: encontre seu curso na AURA Hub Educacional, em Balneário Camboriú.">
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Você está em"><a href="/">Início</a><span>›</span><span>Todos os cursos</span></nav>
      <h1>Encontre o seu curso</h1>
      <p class="sub">Do EJA ao mestrado. Não achou o que procura? Pergunte à Aurora no WhatsApp: temos muito mais opções com as nossas parceiras.</p>
    </div>
  </section>
  <section class="blk" style="padding-top:36px">
    <div class="container">
      <label class="cat-search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="sr-only">Buscar curso</span>
        <input type="search" id="cat-q" placeholder="Buscar curso pelo nome" autocomplete="off" />
      </label>
      <div class="filters" role="group" aria-label="Filtrar por nível">
        <button type="button" data-f="" aria-pressed="true">Todos</button>
        {niveis.map((n) => <button type="button" data-f={n.id} aria-pressed="false">{n.titulo}</button>)}
      </div>
      <div class="courses" id="cat">
        {cursos.map((c, i) => <CourseCard curso={c} idx={i} />)}
      </div>
      <p class="empty" id="cat-empty" hidden>Nenhum curso encontrado com esse filtro. Fale com a Aurora no WhatsApp que ela ajuda você.</p>
    </div>
  </section>

  <script>
    const q = document.getElementById('cat-q') as HTMLInputElement;
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-f]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#cat .co'));
    const empty = document.getElementById('cat-empty')!;
    const params = new URLSearchParams(location.search);
    let nivel = params.get('nivel') ?? '';
    q.value = params.get('q') ?? '';
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    function apply() {
      const terms = norm(q.value.trim()).split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const c of cards) {
        const nome = norm(c.dataset.nome || '');
        const ok = (!nivel || c.dataset.nivel === nivel) && terms.every((t) => nome.includes(t));
        c.hidden = !ok;
        if (ok) shown++;
      }
      empty.hidden = shown > 0;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === nivel)));
    }
    btns.forEach((b) => b.addEventListener('click', () => { nivel = b.dataset.f || ''; apply(); }));
    q.addEventListener('input', apply);
    apply();
  </script>
</Base>
